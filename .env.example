# AgentFlow 环境变量配置

# 应用配置
APP_NAME=AgentFlow
ENVIRONMENT=development
DEBUG=true

# LLM配置
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-your-api-key-here
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# Anthropic配置（可选）
ANTHROPIC_API_KEY=

# 本地LLM配置（可选）
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3

# 数据库配置
DATABASE_URL=sqlite:///./data/agentflow.db

# Redis配置
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Agent配置
MAX_ITERATIONS=10
TIMEOUT_SECONDS=300

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=json

# 向量数据库配置
VECTOR_STORE_TYPE=chroma
VECTOR_STORE_PATH=./data/chroma
EMBEDDING_MODEL=text-embedding-3-small

# API配置
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-this-to-a-random-secret-key

# Streamlit配置
STREAMLIT_PORT=8501
